<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="16dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/v_divider_nav"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >

        <FrameLayout
            android:id="@+id/fl_destacados"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_peach"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp">

            <ImageView
                android:id="@+id/iv_featured_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginEnd="16dp"
                android:layout_marginStart="16dp"
                android:layout_gravity="start|center_vertical"
                android:contentDescription="@string/cd_warning_icon"
                app:srcCompat="@drawable/ic_warning"
                app:tint="@color/color_accent_warning"
                />

            <TextView
                android:id="@+id/tv_featured_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/title_feature"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#5C2D0C"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.25" />

        <LinearLayout
            android:id="@+id/ll_productos"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:baselineAligned="false"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/fl_destacados"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

                <LinearLayout
                    android:id="@+id/ll_product_pijama"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    >

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="110dp"
                        android:background="@drawable/bg_product_top"
                        >

                        <ImageView
                            android:id="@+id/iv_product_pijama"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="8dp"
                            android:scaleType="centerInside"
                            app:srcCompat="@drawable/img_pijama" />


                    </FrameLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="-1.5dp"
                        android:background="@drawable/bg_product_bottom"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:paddingVertical="8dp"
                        >
                        <TextView
                            android:id="@+id/tv_product_pijama_name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/product_pijama_name"
                            android:textColor="#331A05"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tv_product_pijama_price"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/product_pijama_price"
                            android:textColor="#331A05"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                </LinearLayout>


        <LinearLayout
            android:id="@+id/ll_product_ranita"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical"
            >

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="110dp"
                android:background="@drawable/bg_product_top"
                >

                <ImageView
                    android:id="@+id/iv_product_ranita"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="8dp"
                    android:scaleType="centerInside"
                    app:srcCompat="@drawable/img_ranita" />


            </FrameLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-1.5dp"
                android:background="@drawable/bg_product_bottom"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingVertical="8dp"
                >
                <TextView
                    android:id="@+id/tv_product_ranita_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/product_ranita_name"
                    android:textColor="#331A05"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_product_ranita_price"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/product_ranita_price"
                    android:textColor="#331A05"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>


    </LinearLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="0.25" />

    <TextView
        android:id="@+id/tv_categories_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="12dp"
        android:gravity="center"
        android:text="@string/title_categories"
        android:textColor="#331A05"
        android:textSize="18sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/ll_productos"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
    </TextView>

        <FrameLayout
            android:id="@+id/btn_category_bebe"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_peach"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="10dp">

            <ImageView
                android:id="@+id/iv_category_bebe"
                android:layout_width="85dp"
                android:layout_height="85dp"
                android:layout_marginEnd="16dp"
                android:layout_gravity="start|center_vertical"
                app:srcCompat="@drawable/img_bebe"
                android:scaleType="fitCenter"
                />

            <TextView
                android:id="@+id/tv_category_bebe"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/category_bebe"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#5C2D0C"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>


        <FrameLayout
            android:id="@+id/btn_category_nina"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_peach"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/iv_category_nina"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="28dp"
                android:layout_gravity="start|center_vertical"
                app:srcCompat="@drawable/img_nina"
                android:scaleType="centerInside"
                />

            <TextView
                android:id="@+id/tv_category_nina"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/category_nina"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#5C2D0C"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <FrameLayout
            android:id="@+id/btn_category_nino"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_rounded_peach"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="12dp">

            <ImageView
                android:id="@+id/iv_category_nino"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_marginStart="28dp"
                android:layout_gravity="start|center_vertical"
                app:srcCompat="@drawable/img_nino"
                android:scaleType="centerInside"
                />

            <TextView
                android:id="@+id/tv_category_nino"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/category_nino"
                android:fontFamily="@font/roboto_bold"
                android:textColor="#5C2D0C"
                android:textSize="18sp"
                android:textStyle="bold" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="8" />

        <FrameLayout
            android:id="@+id/fl_search_bar"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="16dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_search_bar"
            android:elevation="1dp"
            app:layout_constraintTop_toBottomOf="@id/btn_category_nino"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <EditText
                android:id="@+id/et_search"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@null"
                android:hint="@string/search_hint"
                android:textColorHint="#888888"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:inputType="text"
                android:imeOptions="actionSearch"
                android:singleLine="true"
                android:paddingStart="24dp"
                android:paddingEnd="56dp" />

            <ImageView
                android:id="@+id/iv_search_icon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="20dp"
                android:contentDescription="@string/cd_search_icon"
                app:srcCompat="@drawable/ic_search"
                app:tint="#555555" />

        </FrameLayout>

        <Space
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

        <View
            android:id="@+id/v_divider_nav"
            android:layout_width="0dp"
            android:layout_height="1.5dp"
            android:background="#8C6239"
            app:layout_constraintBottom_toTopOf="@id/bottom_navigation"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <LinearLayout
            android:id="@+id/bottom_navigation"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="@color/color_surface"
            android:elevation="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            >

            <LinearLayout
                android:id="@+id/btn_nav_home"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="54dp"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_nav_active">

                    <ImageView
                        android:id="@+id/iv_nav_home"
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        app:srcCompat="@drawable/ic_nav_home"
                        app:tint="@color/color_nav_active" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tv_nav_home"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:text="@string/nav_home"
                    android:textColor="#331A05"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_nav_cart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_cart"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_nav_cart"
                    app:tint="@color/color_nav_active" />

                <TextView
                    android:id="@+id/tv_nav_cart"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/nav_cart"
                    android:textColor="#331A05"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btn_nav_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:foreground="?attr/selectableItemBackground"
                android:clickable="true"
                android:focusable="true"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/iv_nav_profile"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    app:srcCompat="@drawable/ic_nav_profile"
                    app:tint="@color/color_nav_active" />

                <TextView
                    android:id="@+id/tv_nav_profile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:text="@string/nav_profile"
                    android:textColor="#331A05"
                    android:textSize="11sp"
                    android:textStyle="bold" />


            </LinearLayout>



        </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>